{
  "manifest_version": 3,
  "name": "Overhang",
  "version": "1.0.0",
  "description": "Lays web pages out across the whole front screen of iPhone Duo, with text and buttons kept clear of Safari's column.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-16.png",
      "32": "toolbar-32.png",
      "48": "toolbar-48.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'none'; img-src 'self'"
  }
}
