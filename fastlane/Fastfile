default_platform(:ios)

# Signing is manual: the workflow puts the distribution certificate and the two App Store profiles in a temporary
# keychain, and the Release config in project.yml names the profiles. The App Store Connect key is only used to
# upload and to hand the build to testers.

APP_ID = "pro.imnot.overhang".freeze
EXTENSION_ID = "pro.imnot.overhang.extension".freeze
# bundle id => [App ID name, App Store profile name, file written by `setup`]
SIGNED = {
  APP_ID => ["Overhang", "Overhang AppStore", "profile.mobileprovision"],
  EXTENSION_ID => ["Overhang Extension", "Overhang Extension AppStore", "profile-extension.mobileprovision"]
}.freeze

# A new app has no TestFlight groups; the internal one gets PrivateGallery's internal testers.
TESTER_SOURCE_ID = "pro.imnot.privategallery".freeze

TIP_ID = "pro.imnot.overhang.tip".freeze

ROOT = File.expand_path("..", __dir__)

def asc_login
  require "spaceship"
  require "base64"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
  )
end

def internal_group(app)
  group = (app.get_beta_groups rescue []).find(&:is_internal_group)
  unless group
    # Spaceship's create_beta_group always sends the publicLink fields, which Apple refuses for an internal group.
    body = {
      data: {
        type: "betaGroups",
        attributes: { name: "Internal", isInternalGroup: true, hasAccessToAllBuilds: true },
        relationships: { app: { data: { type: "apps", id: app.id } } }
      }
    }
    group = Spaceship::ConnectAPI.client.test_flight_request_client.post("v1/betaGroups", body).to_models.first
    UI.success("created internal beta group '#{group.name}'")
  end

  have = Spaceship::ConnectAPI.get_beta_testers(filter: { betaGroups: group.id }).all_pages.flat_map(&:to_models)
  if have.empty?
    source = Spaceship::ConnectAPI::App.find(TESTER_SOURCE_ID)
    source_group = source && (source.get_beta_groups rescue []).find(&:is_internal_group)
    testers = source_group ? Spaceship::ConnectAPI.get_beta_testers(filter: { betaGroups: source_group.id }).all_pages.flat_map(&:to_models) : []
    testers.each do |t|
      Spaceship::ConnectAPI.post_beta_tester_assignment(
        beta_group_ids: [group.id],
        attributes: { email: t.email, firstName: t.first_name, lastName: t.last_name }.compact
      )
      # The repo is public, and so are its logs: no addresses here.
      UI.success("added a tester to '#{group.name}'")
    rescue StandardError => e
      UI.important("could not add a tester: #{e.message}. Add them in TestFlight > Internal Testing.")
    end
  end
  group
end

# The ConnectAPI list can lag a few seconds behind a build turning VALID, hence the retries.
def hand_to_testers(build_number)
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  group = internal_group(app)
  build = nil
  10.times do |i|
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-version", limit: 8)
    found = build_number.to_s.empty? ? builds.find { |b| b.processing_state == "VALID" } : builds.find { |b| b.version == build_number.to_s }
    if found&.processing_state == "VALID"
      build = found
      break
    end
    UI.message("build #{build_number} is #{found&.processing_state || 'not listed yet'}; try #{i + 1}/10")
    sleep(20) unless i == 9
  end
  UI.user_error!("build #{build_number} never became VALID") unless build

  if group.has_access_to_all_builds
    UI.success("build #{build.version} is in '#{group.name}' (the group gets every build)")
  else
    build.add_beta_groups(beta_groups: [group])
    UI.success("build #{build.version} added to '#{group.name}'")
  end
end

# Spaceship has no calls for in-app purchases, so these go to the App Store Connect API directly.
def asc(method, path, body = nil)
  require "net/http"
  require "json"
  uri = URI("https://api.appstoreconnect.apple.com/#{path}")
  request = Net::HTTP.const_get(method.capitalize).new(uri)
  request["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
  request["Content-Type"] = "application/json"
  request.body = JSON.generate(body) if body
  response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
  json = response.body.to_s.empty? ? {} : JSON.parse(response.body)
  UI.user_error!("#{method} #{path}: #{response.code} #{json['errors']&.map { |e| e['detail'] }&.join('; ')}") unless response.is_a?(Net::HTTPSuccess)
  json
end

platform :ios do
  # Registers both bundle ids and makes their App Store profiles against the certificate with DIST_CERT_SERIAL.
  # The App Store Connect app record can't be made through the API; this only says whether it exists.
  desc "Register bundle ids and make the App Store profiles"
  lane :setup do
    asc_login
    serial = ENV.fetch("DIST_CERT_SERIAL").downcase.sub(/^0+/, "")
    certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION,IOS_DISTRIBUTION" })
    cert = certs.find { |c| c.serial_number.to_s.downcase.sub(/^0+/, "") == serial }
    UI.user_error!("no distribution certificate with serial #{serial}") unless cert

    SIGNED.each do |identifier, (name, profile_name, file)|
      bid = Spaceship::ConnectAPI::BundleId.find(identifier) ||
            Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS")
      UI.message("bundle id #{identifier} (#{bid.id})")
      Spaceship::ConnectAPI::Profile.all(filter: { name: profile_name }).each(&:delete!)
      profile = Spaceship::ConnectAPI::Profile.create(
        name: profile_name, profile_type: "IOS_APP_STORE",
        bundle_id_id: bid.id, certificate_ids: [cert.id], device_ids: []
      )
      out = File.join(ROOT, "build", file)
      FileUtils.mkdir_p(File.dirname(out))
      File.binwrite(out, Base64.decode64(profile.profile_content))
      UI.success("made profile '#{profile_name}', expires #{profile.expiration_date}")
    end

    app = Spaceship::ConnectAPI::App.find(APP_ID)
    if app
      UI.success("App Store Connect record: #{app.name} (#{app.id})")
      internal_group(app)
    else
      UI.important("no App Store Connect record for #{APP_ID} yet; add it in the web UI")
    end
  end

  desc "Print recent TestFlight builds"
  lane :status do
    asc_login
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-version", limit: 10, includes: "buildBetaDetail").each do |b|
      detail = (b.build_beta_detail rescue nil)
      UI.message("build #{b.version} processing=#{b.processing_state} internal=#{detail&.internal_build_state} uploaded=#{b.uploaded_date}")
    end
  end

  desc "Add a processed build to the internal group (BUILD, or the newest)"
  lane :distribute do
    asc_login
    hand_to_testers(ENV["BUILD"])
  end

  desc "Build, upload to TestFlight and hand the build to testers"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
    build_no = ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)

    sh("cd #{ROOT} && xcodegen generate")
    project = File.join(ROOT, "Overhang.xcodeproj")
    increment_build_number(build_number: build_no, xcodeproj: project)

    # Safari only reloads an extension's scripts when the manifest version changes.
    manifest = File.join(ROOT, "Extension/Resources/manifest.json")
    json = JSON.parse(File.read(manifest))
    json["version"] = "1.0.#{build_no}"
    File.write(manifest, JSON.pretty_generate(json) + "\n")

    team = ENV.fetch("DEVELOPMENT_TEAM")
    build_app(
      project: project,
      scheme: "Overhang",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{team}",
      export_options: {
        signingStyle: "manual",
        teamID: team,
        provisioningProfiles: SIGNED.to_h { |id, (_, profile, _)| [id, profile] }
      },
      output_directory: File.join(ROOT, "build"),
      output_name: "Overhang.ipa",
      clean: true
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: false, distribute_external: false)

    asc_login
    hand_to_testers(build_no)
  end

  # The tip: a $0.99 non-consumable that unlocks nothing. Made once; running it again only reports what's there.
  # Apple still wants a review screenshot of the purchase in the app before the tip can go out with a version.
  desc "Make the tip in-app purchase in App Store Connect"
  lane :tip do
    asc_login
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    have = asc(:get, "v1/apps/#{app.id}/inAppPurchasesV2?filter%5BproductId%5D=#{TIP_ID}")["data"].first
    if have
      UI.success("#{TIP_ID} is there: #{have['attributes']['state']}")
      next
    end

    iap = asc(:post, "v2/inAppPurchases", data: {
      type: "inAppPurchases",
      attributes: {
        name: "Tip", productId: TIP_ID, inAppPurchaseType: "NON_CONSUMABLE", familySharable: false,
        reviewNote: "A tip. It unlocks nothing; every feature of the app works without it. It's in the Support section of the app's main screen."
      },
      relationships: { app: { data: { type: "apps", id: app.id } } }
    })["data"]
    UI.success("made #{TIP_ID} (#{iap['id']})")

    asc(:post, "v1/inAppPurchaseLocalizations", data: {
      type: "inAppPurchaseLocalizations",
      attributes: { locale: "en-CA", name: "Tip", description: "Say thanks. Unlocks nothing." },
      relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: iap["id"] } } }
    })

    points = asc(:get, "v2/inAppPurchases/#{iap['id']}/pricePoints?filter%5Bterritory%5D=USA&limit=200")["data"]
    point = points.find { |p| p["attributes"]["customerPrice"] == "0.99" }
    UI.user_error!("no $0.99 price point") unless point
    asc(:post, "v1/inAppPurchasePriceSchedules", {
      data: {
        type: "inAppPurchasePriceSchedules",
        relationships: {
          inAppPurchase: { data: { type: "inAppPurchases", id: iap["id"] } },
          baseTerritory: { data: { type: "territories", id: "USA" } },
          manualPrices: { data: [{ type: "inAppPurchasePrices", id: "${price}" }] }
        }
      },
      included: [{
        type: "inAppPurchasePrices", id: "${price}",
        attributes: { startDate: nil },
        relationships: { inAppPurchasePricePoint: { data: { type: "inAppPurchasePricePoints", id: point["id"] } } }
      }]
    })
    UI.success("priced at $0.99, other countries follow the US price")

    territories = asc(:get, "v1/territories?limit=200")["data"].map { |t| { type: "territories", id: t["id"] } }
    asc(:post, "v1/inAppPurchaseAvailabilities", data: {
      type: "inAppPurchaseAvailabilities",
      attributes: { availableInNewTerritories: true },
      relationships: {
        inAppPurchase: { data: { type: "inAppPurchases", id: iap["id"] } },
        availableTerritories: { data: territories }
      }
    })
    UI.success("available in #{territories.size} countries")
  end

  # Text, links and review notes come from fastlane/metadata; screenshots from fastlane/screenshots once there are
  # some. Contact details for App Review, pricing, age rating and the privacy answers are set in App Store Connect,
  # since the repo is public and the API doesn't cover the privacy answers.
  desc "Upload the App Store listing for BUILD (or the newest build); SUBMIT=1 also sends it for review"
  lane :store do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
    screenshots = File.join(ROOT, "fastlane/screenshots")
    have_screenshots = Dir.glob(File.join(screenshots, "*/*.png")).any?

    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: "1.0",
      build_number: ENV["BUILD"].to_s.empty? ? nil : ENV["BUILD"],
      metadata_path: File.join(ROOT, "fastlane/metadata"),
      screenshots_path: screenshots,
      skip_screenshots: !have_screenshots,
      overwrite_screenshots: have_screenshots,
      skip_binary_upload: true,
      skip_app_version_update: false,
      submit_for_review: ENV["SUBMIT"] == "1",
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end
end
